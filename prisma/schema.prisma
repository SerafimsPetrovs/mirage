generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  CREATOR
  ADMIN
}

enum Orientation {
  VERTICAL
  HORIZONTAL
}

enum SeriesStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum CoinReason {
  PURCHASE
  UNLOCK
  CHECKIN
  BONUS
  REFUND
  ADMIN
  POLL_BOOST
  SKIN
  SCENE
  CHAT
  PHOTO
  PROMO
  CAMEO
}

enum OrderKind {
  COINS
  VIP
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum SubStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum GenStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum AppStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  avatarHue          Int       @default(330)
  role               Role      @default(VIEWER)
  /// Coins bought with real money. Only these produce withdrawable creator earnings.
  paidCoins          Int       @default(0)
  /// Free coins (welcome bonus, daily check-in, admin grants). Spent first.
  bonusCoins         Int       @default(0)
  genCredits         Int       @default(100)
  /// bcrypt hash of the 4-digit parental PIN for kids mode.
  kidsPinHash        String?
  kidsPinFails       Int       @default(0)
  kidsPinLockedUntil DateTime?
  /// Set when the user confirmed they are 18+ (needed for spicy add-ons).
  adultConfirmedAt   DateTime?
  /// Viewer opted in to see 18+ series and fan-service add-ons (off by default; never in kids mode).
  showAdult          Boolean   @default(false)
  /// Creator's withdrawable coins (cache of earnings.coins minus open/paid payouts).
  payoutCoins        Int       @default(0)
  /// Personal invite code (created on first visit to /me/invite).
  refCode            String?   @unique
  /// Who invited this user; the inviter is rewarded once this user comes back on another day.
  referredById       String?
  refRewardedAt      DateTime?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]    @relation("Referrals")
  bio                String?
  banned             Boolean   @default(false)
  createdAt          DateTime  @default(now())

  sessions         Session[]
  subscription     Subscription?
  series           Series[]
  unlocks          Unlock[]
  transactions     CoinTransaction[]
  orders           Order[]
  earnings         CreatorEarning[]
  payouts          Payout[]
  promoRedemptions PromoRedemption[]
  adViews          AdView[]
  passwordResets   PasswordReset[]
  cameos           Cameo[]
  progress         WatchProgress[]
  listItems        ListItem[]
  likes            Like[]
  comments         Comment[]
  ratings          Rating[]
  checkIns         CheckIn[]
  pollVotes        PollVote[]
  applications     CreatorApplication[]
  generations      GenerationJob[]
  kidsAllowances   KidsAllowance[]
  pollBoosts       PollBoost[]
  skinUnlocks      SkinUnlock[]
  sceneUnlocks     SceneUnlock[]
  chatThreads      ChatThread[]
  photoUnlocks     PhotoUnlock[]
}

model Session {
  id        String   @id
  userId    String
  /// Kids mode is per session/device: entering is one click, leaving needs the parent PIN.
  kidsMode  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             String
  status           SubStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Series {
  id               String       @id @default(cuid())
  slug             String       @unique
  titleRu          String
  titleEn          String
  taglineRu        String       @default("")
  taglineEn        String       @default("")
  descriptionRu    String
  descriptionEn    String
  orientation      Orientation  @default(VERTICAL)
  posterUrl        String?
  backdropUrl      String?
  hue              Int          @default(330)
  genres           String       @default("")
  moods            String       @default("")
  aiModels         String       @default("")
  promptNotesRu    String       @default("")
  promptNotesEn    String       @default("")
  ageRating        String       @default("16+")
  status           SeriesStatus @default(DRAFT)
  rejectReason     String?
  featured         Boolean      @default(false)
  /// Set by moderators. Only these series are visible in kids mode.
  isFamilySafe     Boolean      @default(false)
  /// 18+ series: hidden from catalog/search/feed unless the viewer enabled 18+ content.
  isAdult          Boolean      @default(false)
  /// Set by a moderator: the creator can no longer turn 18+ off.
  adultLocked      Boolean      @default(false)
  /// "The series the internet writes": daily episodes driven by polls, cameo names, show admin.
  interactive      Boolean      @default(false)
  freeEpisodes     Int          @default(5)
  defaultCoinPrice Int          @default(30)
  views            Int          @default(0)
  creatorId        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  publishedAt      DateTime?

  creator        User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  episodes       Episode[]
  listItems      ListItem[]
  ratings        Rating[]
  polls          Poll[]
  progress       WatchProgress[]
  characters     Character[]
  kidsAllowances KidsAllowance[]
  earnings       CreatorEarning[]
  cameos         Cameo[]
  showScripts    ShowScript[]

  @@index([status, featured])
  @@index([creatorId])
}

model Episode {
  id           String   @id @default(cuid())
  seriesId     String
  number       Int
  titleRu      String   @default("")
  titleEn      String   @default("")
  durationSec  Int      @default(90)
  videoUrl     String
  thumbnailUrl String?
  coinPrice    Int?
  views        Int      @default(0)
  createdAt    DateTime @default(now())

  series       Series            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  unlocks      Unlock[]
  likes        Like[]
  comments     Comment[]
  progress     WatchProgress[]
  earnings     CreatorEarning[]
  transactions CoinTransaction[]
  skins        Skin[]
  bonusScene   BonusScene?
  cameos       Cameo[]

  @@unique([seriesId, number])
}

model Unlock {
  userId    String
  episodeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
}

model CoinTransaction {
  id        String     @id @default(cuid())
  userId    String
  /// Signed total = paid + bonus.
  amount    Int
  paid      Int        @default(0)
  bonus     Int        @default(0)
  reason    CoinReason
  note      String?
  episodeId String?
  orderId   String?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode?   @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  kind        OrderKind
  sku         String
  amountCents Int
  currency    String
  status      OrderStatus @default(PENDING)
  provider    String
  createdAt   DateTime    @default(now())
  paidAt      DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Creator's share of a purchase. `coins` = withdrawable (from paid coins only);
/// `credits` = generation credits (from bonus coins, not withdrawable).
model CreatorEarning {
  id        String   @id @default(cuid())
  creatorId String
  episodeId String?
  seriesId  String?
  /// UNLOCK | POLL_BOOST | SKIN | SCENE | CHAT | PHOTO
  source    String   @default("UNLOCK")
  coins     Int      @default(0)
  credits   Int      @default(0)
  createdAt DateTime @default(now())
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([creatorId, createdAt])
}

model WatchProgress {
  userId      String
  episodeId   String
  seriesId    String
  positionSec Int      @default(0)
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId, updatedAt])
}

model ListItem {
  userId    String
  seriesId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
}

model Like {
  userId    String
  episodeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, createdAt])
}

model Rating {
  userId   String
  seriesId String
  value    Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
}

model CheckIn {
  userId    String
  day       String
  streak    Int
  reward    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model Poll {
  id         String       @id @default(cuid())
  seriesId   String
  questionRu String
  questionEn String
  closesAt   DateTime
  createdAt  DateTime     @default(now())
  series     Series       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  options    PollOption[]
  votes      PollVote[]
  boosts     PollBoost[]
}

model PollOption {
  id      String      @id @default(cuid())
  pollId  String
  labelRu String
  labelEn String
  poll    Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes   PollVote[]
  boosts  PollBoost[]
}

model PollVote {
  userId   String
  pollId   String
  optionId String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([userId, pollId])
}

model CreatorApplication {
  id        String    @id @default(cuid())
  userId    String
  message   String
  portfolio String    @default("")
  status    AppStatus @default(PENDING)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// AI video generation job (creator studio). Provider "mock" simulates progress
/// over time and returns a demo clip; a real provider (ComfyUI etc.) plugs in later.
model GenerationJob {
  id          String      @id @default(cuid())
  userId      String
  prompt      String
  style       String      @default("cinematic")
  orientation Orientation @default(VERTICAL)
  durationSec Int         @default(5)
  seed        Int
  cost        Int
  provider    String      @default("mock")
  status      GenStatus   @default(QUEUED)
  resultUrl   String?
  error       String?
  createdAt   DateTime    @default(now())
  finishedAt  DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// "Allow auto-unlocking episodes of this series today", granted by a parent with the PIN.
model KidsAllowance {
  userId   String
  seriesId String
  day      String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId, day])
}

/// Extra paid votes in a "What's next?" poll (on top of the free one).
model PollBoost {
  id        String     @id @default(cuid())
  userId    String
  pollId    String
  optionId  String
  votes     Int
  coins     Int
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([pollId])
}

/// Alternative cut of an episode with a different outfit ("skin").
/// The player swaps the stream to this file at the current second.
model Skin {
  id        String       @id @default(cuid())
  episodeId String
  nameRu    String
  nameEn    String
  emoji     String       @default("👗")
  /// common | rare | epic (roulette weights)
  rarity    String       @default("common")
  videoUrl  String
  price     Int          @default(40)
  createdAt DateTime     @default(now())
  episode   Episode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  unlocks   SkinUnlock[]

  @@index([episodeId])
}

model SkinUnlock {
  userId    String
  skinId    String
  /// buy | spin
  via       String   @default("buy")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skin      Skin     @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@id([userId, skinId])
}

/// Paid 18+ bonus clip attached to an episode ("uncut scene").
model BonusScene {
  id           String        @id @default(cuid())
  episodeId    String        @unique
  titleRu      String
  titleEn      String
  videoUrl     String
  durationSec  Int           @default(30)
  price        Int           @default(30)
  /// Second of the main episode when the offer pops up; null = at the end.
  triggerAtSec Int?
  createdAt    DateTime      @default(now())
  episode      Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  unlocks      SceneUnlock[]
}

model SceneUnlock {
  userId    String
  sceneId   String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene     BonusScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@id([userId, sceneId])
}

/// A series character viewers can chat with (LLM-backed). Always an adult (age >= 18).
model Character {
  id         String           @id @default(cuid())
  seriesId   String
  nameRu     String
  nameEn     String
  taglineRu  String           @default("")
  taglineEn  String           @default("")
  greetingRu String           @default("")
  greetingEn String           @default("")
  /// Creator-written personality prompt.
  persona    String
  age        Int
  avatarUrl  String?
  hue        Int              @default(330)
  createdAt  DateTime         @default(now())
  series     Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  photos     CharacterPhoto[]
  threads    ChatThread[]

  @@index([seriesId])
}

/// "Exclusive set photo / selfie" the character can send in chat, blurred until bought.
model CharacterPhoto {
  id          String        @id @default(cuid())
  characterId String
  imageUrl    String
  captionRu   String        @default("")
  captionEn   String        @default("")
  price       Int           @default(25)
  order       Int           @default(0)
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  unlocks     PhotoUnlock[]
  messages    ChatMessage[]
}

model PhotoUnlock {
  userId    String
  photoId   String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     CharacterPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
}

model ChatThread {
  id           String        @id @default(cuid())
  userId       String
  characterId  String
  /// Messages the viewer has sent (the first few are free).
  userMessages Int           @default(0)
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  character    Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@unique([userId, characterId])
}

model ChatMessage {
  id        String          @id @default(cuid())
  threadId  String
  /// user | character
  role      String
  body      String
  photoId   String?
  createdAt DateTime        @default(now())
  thread    ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  photo     CharacterPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

/// Creator withdrawal request. Coins are reserved (User.payoutCoins decremented) when created,
/// returned on REJECTED/CANCELED. Flow: PENDING → APPROVED → PAID, or → REJECTED / CANCELED.
model Payout {
  id          String    @id @default(cuid())
  userId      String
  coins       Int
  amountCents Int
  currency    String    @default("EUR")
  /// IBAN | PAYPAL | CARD
  method      String
  details     String
  holderName  String
  /// PENDING | APPROVED | PAID | REJECTED | CANCELED
  status      String    @default("PENDING")
  adminNote   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Promo code. COINS grants bonus coins (never withdrawable), VIP_DAYS extends VIP.
model PromoCode {
  id           String            @id @default(cuid())
  /// Upper-case, unique.
  code         String            @unique
  /// COINS | VIP_DAYS
  kind         String
  value        Int
  /// null = unlimited
  maxUses      Int?
  usesCount    Int               @default(0)
  expiresAt    DateTime?
  /// Only accounts registered after the code was created.
  newUsersOnly Boolean           @default(false)
  active       Boolean           @default(true)
  note         String?
  createdAt    DateTime          @default(now())
  redemptions  PromoRedemption[]
}

model PromoRedemption {
  promoId   String
  userId    String
  createdAt DateTime  @default(now())
  promo     PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([promoId, userId])
  @@index([userId])
}

/// Rewarded ad view: watching ADS_PER_EPISODE ads to the end unlocks a paid episode for free.
model AdView {
  id          String    @id @default(cuid())
  userId      String
  episodeId   String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// This view completed the set and created the Unlock.
  unlocked    Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, episodeId])
  @@index([userId, startedAt])
}

/// One-time password reset link. Only the SHA-256 of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A viewer's name that appears in an interactive series ("get into the series").
model Cameo {
  id        String   @id @default(cuid())
  userId    String?
  seriesId  String
  /// Display name shown in the episode credits (and written into the script).
  name      String
  /// BOUGHT (paid with coins) | TOP (gift for top supporters) | GIFT (admin)
  kind      String   @default("BOUGHT")
  coins     Int      @default(0)
  /// PENDING (moderation) | APPROVED (queued for the next episode) | AIRED | REJECTED
  status    String   @default("PENDING")
  episodeId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([seriesId, status])
  @@index([userId])
}

/// Writers' room draft for the next episode of an interactive series (written by the LLM, edited by the admin).
model ShowScript {
  id           String   @id @default(cuid())
  seriesId     String
  number       Int
  title        String
  content      String
  pollQuestion String
  optionA      String
  optionB      String
  caption      String   @default("")
  episodeId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  series       Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId, number])
}
