generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  CREATOR
  ADMIN
}

enum Orientation {
  VERTICAL
  HORIZONTAL
}

enum SeriesStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum CoinReason {
  PURCHASE
  UNLOCK
  CHECKIN
  BONUS
  REFUND
  ADMIN
  POLL_BOOST
  SKIN
  SCENE
  CHAT
  PHOTO
  PROMO
  CAMEO
  TV_ORDER
  TV_TICKER
  TV_SUPERCHAT
  APP
  BOUNTY
  BUDDY
}

enum OrderKind {
  COINS
  VIP
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum SubStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum GenStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum AppStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  /// Set when the user clicked the link in the confirmation email (needed for payouts and referral rewards).
  emailVerifiedAt    DateTime?
  passwordHash       String
  name               String
  avatarHue          Int       @default(330)
  role               Role      @default(VIEWER)
  /// Coins bought with real money. Only these produce withdrawable creator earnings.
  paidCoins          Int       @default(0)
  /// Free coins (welcome bonus, daily check-in, admin grants). Spent first.
  bonusCoins         Int       @default(0)
  genCredits         Int       @default(100)
  /// Gold: free-to-earn currency (check-in, watching, votes, correct predictions). Never bought or converted from coins.
  gold               Int       @default(0)
  /// bcrypt hash of the 4-digit parental PIN for kids mode.
  kidsPinHash        String?
  kidsPinFails       Int       @default(0)
  kidsPinLockedUntil DateTime?
  /// Set when the user confirmed they are 18+ (needed for spicy add-ons).
  adultConfirmedAt   DateTime?
  /// Viewer opted in to see 18+ series and fan-service add-ons (off by default; never in kids mode).
  showAdult          Boolean   @default(false)
  /// Creator's withdrawable coins (cache of earnings.coins minus open/paid payouts).
  payoutCoins        Int       @default(0)
  /// Personal invite code (created on first visit to /me/invite).
  refCode            String?   @unique
  /// Who invited this user; the inviter is rewarded once this user comes back on another day.
  referredById       String?
  refRewardedAt      DateTime?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]    @relation("Referrals")
  bio                String?
  banned             Boolean   @default(false)
  createdAt          DateTime  @default(now())

  sessions         Session[]
  subscription     Subscription?
  series           Series[]
  unlocks          Unlock[]
  transactions     CoinTransaction[]
  orders           Order[]
  earnings         CreatorEarning[]
  payouts          Payout[]
  promoRedemptions PromoRedemption[]
  adViews          AdView[]
  passwordResets   PasswordReset[]
  emailTokens      EmailVerification[]
  cameos           Cameo[]
  reports          Report[]
  progress         WatchProgress[]
  listItems        ListItem[]
  likes            Like[]
  comments         Comment[]
  ratings          Rating[]
  checkIns         CheckIn[]
  pollVotes        PollVote[]
  applications     CreatorApplication[]
  generations      GenerationJob[]
  kidsAllowances   KidsAllowance[]
  pollBoosts       PollBoost[]
  skinUnlocks      SkinUnlock[]
  sceneUnlocks     SceneUnlock[]
  chatThreads      ChatThread[]
  photoUnlocks     PhotoUnlock[]
  goldTx           GoldTransaction[]
  wmSessions       WatermarkSession[]
  predictionBets   PredictionBet[]
  tvClips          TvClip[]
  musicTracks      MusicTrack[]
  partiesHosted    Party[]       @relation("PartyHost")
  partyMembers     PartyMember[]
  partyEvents      PartyEvent[]
  partyFood        PartyFood[]
  tvMoments        TvMoment[]
  songs            Song[]
  songSaves        SongSave[]
  tvMessages       TvMessage[]
  tvTickers        TvTicker[]
  tvOrders         TvOrder[]
  tvLikes          TvClipLike[]
  /// Muted in MIRAGE TV chats until this moment (moderation).
  tvMutedUntil     DateTime?
  /// Watch buddy: the chosen companion and what it wears ({"hat":"cap","face":null,"neck":"scarf"}).
  buddyId          String    @default("blip")
  buddyOutfit      String    @default("{}")
  buddyItems       BuddyItem[]
  tvPollVotes      TvPollVote[]
  tvQuizAnswers    TvQuizAnswer[]
  tvWatch          TvWatch[]
  tvGames          TvGame[]
  invitesOwned     CreatorInvite[] @relation("InviteOwner")
  inviteUsed       CreatorInvite?  @relation("InviteUser")
  creatorTasks     CreatorTask[]
  appPurchases     AiAppPurchase[]
}

model Session {
  id        String   @id
  userId    String
  /// Kids mode is per session/device: entering is one click, leaving needs the parent PIN.
  kidsMode  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             String
  status           SubStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Series {
  id               String       @id @default(cuid())
  slug             String       @unique
  titleRu          String
  titleEn          String
  taglineRu        String       @default("")
  taglineEn        String       @default("")
  descriptionRu    String
  descriptionEn    String
  orientation      Orientation  @default(VERTICAL)
  posterUrl        String?
  backdropUrl      String?
  hue              Int          @default(330)
  genres           String       @default("")
  moods            String       @default("")
  aiModels         String       @default("")
  promptNotesRu    String       @default("")
  promptNotesEn    String       @default("")
  ageRating        String       @default("16+")
  status           SeriesStatus @default(DRAFT)
  rejectReason     String?
  featured         Boolean      @default(false)
  /// Set by moderators. Only these series are visible in kids mode.
  isFamilySafe     Boolean      @default(false)
  /// 18+ series: hidden from catalog/search/feed unless the viewer enabled 18+ content.
  isAdult          Boolean      @default(false)
  /// Set by a moderator: the creator can no longer turn 18+ off.
  adultLocked      Boolean      @default(false)
  /// "The series the internet writes": daily episodes driven by polls, cameo names, show admin.
  interactive      Boolean      @default(false)
  /// Admin-pinned place in the "Top 10" row (1 = first). Null = ranked by views.
  chartRank        Int?
  freeEpisodes     Int          @default(5)
  defaultCoinPrice Int          @default(30)
  views            Int          @default(0)
  creatorId        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  publishedAt      DateTime?

  creator        User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  episodes       Episode[]
  listItems      ListItem[]
  ratings        Rating[]
  polls          Poll[]
  progress       WatchProgress[]
  characters     Character[]
  kidsAllowances KidsAllowance[]
  earnings       CreatorEarning[]
  cameos         Cameo[]
  showScripts    ShowScript[]
  predictions    Prediction[]
  tvClips        TvClip[]
  funnelClicks   TvFunnelClick[]
  tasks          CreatorTask[]

  @@index([status, featured])
  @@index([creatorId])
}

model Episode {
  id           String   @id @default(cuid())
  seriesId     String
  number       Int
  titleRu      String   @default("")
  titleEn      String   @default("")
  durationSec  Int      @default(90)
  videoUrl     String
  thumbnailUrl String?
  coinPrice    Int?
  views        Int      @default(0)
  /// Release scheduler: hidden from viewers until this moment (null = released).
  publishAt    DateTime?
  createdAt    DateTime @default(now())

  series       Series            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  unlocks      Unlock[]
  likes        Like[]
  comments     Comment[]
  progress     WatchProgress[]
  earnings     CreatorEarning[]
  transactions CoinTransaction[]
  skins        Skin[]
  bonusScene   BonusScene?
  cameos       Cameo[]
  predictions  Prediction[]
  tvSlots      TvSlot[]

  @@unique([seriesId, number])
}

model Unlock {
  userId    String
  episodeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
}

model CoinTransaction {
  id        String     @id @default(cuid())
  userId    String
  /// Signed total = paid + bonus.
  amount    Int
  paid      Int        @default(0)
  bonus     Int        @default(0)
  reason    CoinReason
  note      String?
  episodeId String?
  orderId   String?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode?   @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  kind        OrderKind
  sku         String
  amountCents Int
  currency    String
  status      OrderStatus @default(PENDING)
  provider    String
  /// Promo discount applied to this order, percent (0 = none). amountCents is already discounted.
  discountPct Int         @default(0)
  createdAt   DateTime    @default(now())
  paidAt      DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Creator's share of a purchase. `coins` = withdrawable (from paid coins only);
/// `credits` = generation credits (from bonus coins, not withdrawable).
model CreatorEarning {
  id        String   @id @default(cuid())
  creatorId String
  episodeId String?
  seriesId  String?
  /// UNLOCK | POLL_BOOST | SKIN | SCENE | CHAT | PHOTO
  source    String   @default("UNLOCK")
  coins     Int      @default(0)
  credits   Int      @default(0)
  createdAt DateTime @default(now())
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([creatorId, createdAt])
}

model WatchProgress {
  userId      String
  episodeId   String
  seriesId    String
  positionSec Int      @default(0)
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId, updatedAt])
}

model ListItem {
  userId    String
  seriesId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
}

model Like {
  userId    String
  episodeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, createdAt])
}

model Rating {
  userId   String
  seriesId String
  value    Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
}

model CheckIn {
  userId    String
  day       String
  streak    Int
  reward    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model Poll {
  id         String       @id @default(cuid())
  seriesId   String
  questionRu String
  questionEn String
  closesAt   DateTime
  createdAt  DateTime     @default(now())
  series     Series       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  options    PollOption[]
  votes      PollVote[]
  boosts     PollBoost[]
}

model PollOption {
  id      String      @id @default(cuid())
  pollId  String
  labelRu String
  labelEn String
  poll    Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes   PollVote[]
  boosts  PollBoost[]
}

model PollVote {
  userId   String
  pollId   String
  optionId String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([userId, pollId])
}

model CreatorApplication {
  id        String    @id @default(cuid())
  userId    String
  message   String
  portfolio String    @default("")
  status    AppStatus @default(PENDING)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// AI video generation job (creator studio). Provider "mock" simulates progress
/// over time and returns a demo clip; a real provider (ComfyUI etc.) plugs in later.
model GenerationJob {
  id          String      @id @default(cuid())
  userId      String
  prompt      String
  style       String      @default("cinematic")
  orientation Orientation @default(VERTICAL)
  durationSec Int         @default(5)
  seed        Int
  cost        Int
  provider    String      @default("mock")
  status      GenStatus   @default(QUEUED)
  resultUrl   String?
  error       String?
  createdAt   DateTime    @default(now())
  finishedAt  DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// "Allow auto-unlocking episodes of this series today", granted by a parent with the PIN.
model KidsAllowance {
  userId   String
  seriesId String
  day      String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId, day])
}

/// Extra paid votes in a "What's next?" poll (on top of the free one).
model PollBoost {
  id        String     @id @default(cuid())
  userId    String
  pollId    String
  optionId  String
  votes     Int
  coins     Int
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([pollId])
}

/// Alternative cut of an episode with a different outfit ("skin").
/// The player swaps the stream to this file at the current second.
model Skin {
  id        String       @id @default(cuid())
  episodeId String
  nameRu    String
  nameEn    String
  emoji     String       @default("👗")
  /// common | rare | epic (roulette weights)
  rarity    String       @default("common")
  videoUrl  String
  price     Int          @default(40)
  createdAt DateTime     @default(now())
  episode   Episode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  unlocks   SkinUnlock[]

  @@index([episodeId])
}

model SkinUnlock {
  userId    String
  skinId    String
  /// buy | spin
  via       String   @default("buy")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skin      Skin     @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@id([userId, skinId])
}

/// Paid 18+ bonus clip attached to an episode ("uncut scene").
model BonusScene {
  id           String        @id @default(cuid())
  episodeId    String        @unique
  titleRu      String
  titleEn      String
  videoUrl     String
  durationSec  Int           @default(30)
  price        Int           @default(30)
  /// Second of the main episode when the offer pops up; null = at the end.
  triggerAtSec Int?
  createdAt    DateTime      @default(now())
  episode      Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  unlocks      SceneUnlock[]
}

model SceneUnlock {
  userId    String
  sceneId   String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene     BonusScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@id([userId, sceneId])
}

/// A series character viewers can chat with (LLM-backed). Always an adult (age >= 18).
model Character {
  id         String           @id @default(cuid())
  seriesId   String
  nameRu     String
  nameEn     String
  taglineRu  String           @default("")
  taglineEn  String           @default("")
  greetingRu String           @default("")
  greetingEn String           @default("")
  /// Creator-written personality prompt.
  persona    String
  age        Int
  avatarUrl  String?
  hue        Int              @default(330)
  createdAt  DateTime         @default(now())
  series     Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  photos     CharacterPhoto[]
  threads    ChatThread[]

  @@index([seriesId])
}

/// "Exclusive set photo / selfie" the character can send in chat, blurred until bought.
model CharacterPhoto {
  id          String        @id @default(cuid())
  characterId String
  imageUrl    String
  captionRu   String        @default("")
  captionEn   String        @default("")
  price       Int           @default(25)
  order       Int           @default(0)
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  unlocks     PhotoUnlock[]
  messages    ChatMessage[]
}

model PhotoUnlock {
  userId    String
  photoId   String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     CharacterPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
}

model ChatThread {
  id           String        @id @default(cuid())
  userId       String
  characterId  String
  /// Messages the viewer has sent (the first few are free).
  userMessages Int           @default(0)
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  character    Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@unique([userId, characterId])
}

model ChatMessage {
  id        String          @id @default(cuid())
  threadId  String
  /// user | character
  role      String
  body      String
  photoId   String?
  createdAt DateTime        @default(now())
  thread    ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  photo     CharacterPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

/// Creator withdrawal request. Coins are reserved (User.payoutCoins decremented) when created,
/// returned on REJECTED/CANCELED. Flow: PENDING → APPROVED → PAID, or → REJECTED / CANCELED.
model Payout {
  id          String    @id @default(cuid())
  userId      String
  coins       Int
  amountCents Int
  currency    String    @default("EUR")
  /// IBAN | PAYPAL | CARD
  method      String
  details     String
  holderName  String
  /// PENDING | APPROVED | PAID | REJECTED | CANCELED
  status      String    @default("PENDING")
  adminNote   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Promo code. COINS grants bonus coins (never withdrawable), VIP_DAYS extends VIP.
model PromoCode {
  id           String            @id @default(cuid())
  /// Upper-case, unique.
  code         String            @unique
  /// COINS | VIP_DAYS | DISCOUNT (value = percent off the next coin pack)
  kind         String
  value        Int
  /// null = unlimited
  maxUses      Int?
  usesCount    Int               @default(0)
  expiresAt    DateTime?
  /// Only accounts registered after the code was created.
  newUsersOnly Boolean           @default(false)
  active       Boolean           @default(true)
  note         String?
  createdAt    DateTime          @default(now())
  redemptions  PromoRedemption[]
}

model PromoRedemption {
  promoId   String
  userId    String
  /// DISCOUNT codes: the coin-pack order the discount went to (null = not used yet; reassigned while that order is unpaid).
  orderId   String?
  createdAt DateTime  @default(now())
  promo     PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([promoId, userId])
  @@index([userId])
}

/// Rewarded ad view: watching ADS_PER_EPISODE ads to the end unlocks a paid episode for free.
model AdView {
  id          String    @id @default(cuid())
  userId      String
  episodeId   String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// This view completed the set and created the Unlock.
  unlocked    Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, episodeId])
  @@index([userId, startedAt])
}

/// One-time password reset link. Only the SHA-256 of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A viewer's name that appears in an interactive series ("get into the series").
model Cameo {
  id        String   @id @default(cuid())
  userId    String?
  seriesId  String
  /// Display name shown in the episode credits (and written into the script).
  name      String
  /// BOUGHT (paid with coins) | TOP (gift for top supporters) | GIFT (admin)
  kind      String   @default("BOUGHT")
  coins     Int      @default(0)
  /// PENDING (moderation) | APPROVED (queued for the next episode) | AIRED | REJECTED
  status    String   @default("PENDING")
  episodeId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([seriesId, status])
  @@index([userId])
}

/// Writers' room draft for the next episode of an interactive series (written by the LLM, edited by the admin).
model ShowScript {
  id           String   @id @default(cuid())
  seriesId     String
  number       Int
  title        String
  content      String
  pollQuestion String
  optionA      String
  optionB      String
  caption      String   @default("")
  episodeId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  series       Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId, number])
}

/// Every admin action (who changed what), shown in /admin/log.
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

/// Viewer complaint about a series, comment or character (or a copyright notice from anyone).
model Report {
  id           String    @id @default(cuid())
  /// null = anonymous copyright notice from the public form
  reporterId   String?
  /// SERIES | COMMENT | CHARACTER | URL
  targetType   String
  targetId     String
  /// spam | abuse | sexual | minors | violence | copyright | other
  reason       String
  details      String    @default("")
  contactEmail String?
  /// OPEN | RESOLVED | DISMISSED
  status       String    @default("OPEN")
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  reporter     User?     @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// One-time link from the "confirm your email" message (only the SHA-256 of the token is stored).
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Gold ledger. Gold is earned for free (never bought, never converted from coins) and spent on
/// predictions and episode unlocks. `day` (UTC yyyy-mm-dd) enforces daily earning caps.
model GoldTransaction {
  id        String   @id @default(cuid())
  userId    String
  /// Signed.
  amount    Int
  /// WELCOME | CHECKIN | WATCH | VOTE | RATE | BET | WIN | REFUND | UNLOCK | BUDDY | ADMIN
  reason    String
  refId     String?
  day       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reason, day])
  @@index([userId, createdAt])
}

/// "Guess what happens next": asked after an episode, closes when the next episode comes out,
/// resolved by the creator. Bets are in gold; the split of bets stays hidden until the result.
model Prediction {
  id          String             @id @default(cuid())
  seriesId    String
  /// The episode after which the question is asked; bets close once a later episode exists.
  episodeId   String
  questionRu  String
  questionEn  String
  allowCustom Boolean            @default(true)
  /// OPEN | RESOLVED | CANCELED
  status      String             @default("OPEN")
  resolvedAt  DateTime?
  createdAt   DateTime           @default(now())
  series      Series             @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode     Episode            @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  options     PredictionOption[]
  bets        PredictionBet[]

  @@index([seriesId, createdAt])
  @@index([episodeId])
}

model PredictionOption {
  id           String          @id @default(cuid())
  predictionId String
  labelRu      String
  labelEn      String
  correct      Boolean         @default(false)
  prediction   Prediction      @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  bets         PredictionBet[]
}

/// One bet per viewer per prediction: a ready option or the viewer's own guess (customText).
model PredictionBet {
  id           String            @id @default(cuid())
  predictionId String
  userId       String
  optionId     String?
  customText   String?
  stake        Int
  /// Custom guesses: set by the creator when resolving.
  customOk     Boolean           @default(false)
  /// PENDING | WON | LOST | REFUNDED
  status       String            @default("PENDING")
  payout       Int               @default(0)
  createdAt    DateTime          @default(now())
  prediction   Prediction        @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  option       PredictionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([predictionId, userId])
  @@index([predictionId])
}

/// Forensic watermark package of one source video (shared by every episode that uses the same file):
/// two HLS encodes A and B that differ only by an invisible low-frequency luma pattern.
model WatermarkAsset {
  id        String             @id @default(cuid())
  /// Media ref of the source video (storage:/demo:), unique.
  sourceRef String             @unique
  /// Folder under storage/wm/.
  dir       String             @unique
  /// PENDING | RUNNING | READY | FAILED
  status    String             @default("PENDING")
  segments  Int                @default(0)
  segSec    Int                @default(2)
  error     String?
  createdAt DateTime           @default(now())
  readyAt   DateTime?
  sessions  WatermarkSession[]
}

/// Which A/B sequence (code) a signed-in viewer receives for an asset. Code 0 = guests (all A).
model WatermarkSession {
  id        String         @id @default(cuid())
  assetId   String
  userId    String
  code      Int
  createdAt DateTime       @default(now())
  asset     WatermarkAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assetId, userId])
  @@unique([assetId, code])
}

// ───────────────────────────── MIRAGE TV ─────────────────────────────

/// A 24/7 channel of the interdimensional TV. Everyone watching it sees the same slot at the same second.
model TvChannel {
  id          String   @id @default(cuid())
  slug        String   @unique
  /// Channel number on the remote (unique).
  number      Int      @unique
  nameRu      String
  nameEn      String
  taglineRu   String   @default("")
  taglineEn   String   @default("")
  /// ABSURD | DOCS | DARK | MUSIC | CHILL | SERIES | KIDS | NIGHT — picks host templates and the look.
  kind        String
  /// Catalog genres (comma separated) whose free episodes fill gaps between TV clips. Empty = no episodes.
  genres      String   @default("")
  hue         Int      @default(330)
  hostName    String
  /// Character description for the LLM showrunner (fictional hosts only).
  hostPersona String   @default("")
  /// Visible only in family mode, and only family-safe content.
  familyOnly  Boolean  @default(false)
  /// 18+ channel: only for viewers with 18+ enabled.
  isAdult     Boolean  @default(false)
  /// SMS greetings ticker (music channel).
  ticker      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  /// Hosts a quiz every half hour.
  quiz     Boolean  @default(true)
  /// Bounty hub: minutes of fresh content the channel needs per 24 h.
  bufferTargetMin Int       @default(120)
  /// Admin's manual "deficit / bounty x2" switch (until this moment).
  bountyUntil     DateTime?
  alerts       TvAlert[]
  injections   TvInjection[]
  funnelClicks TvFunnelClick[]
  slots    TvSlot[]
  clips    TvClip[]
  musicTracks MusicTrack[]
  messages TvMessage[]
  tickers  TvTicker[]
  orders   TvOrder[]
  polls    TvPoll[]
  factory  TvFactoryItem[]
}

/// TV-only content: shows, bumpers, fake/sponsored ads, music videos.
model TvClip {
  id          String      @id @default(cuid())
  channelId   String
  /// SHOW | BUMPER | AD | MUSIC
  kind        String      @default("SHOW")
  title       String
  /// Music videos: performer shown in the corner caption.
  artist      String      @default("")
  videoUrl    String
  durationSec Int         @default(30)
  orientation Orientation @default(HORIZONTAL)
  /// PENDING (moderation) | APPROVED | REJECTED
  status      String      @default("PENDING")
  /// "Sponsored by …" plate for clips ordered by viewers.
  sponsorName String?
  creatorId   String?
  plays       Int         @default(0)
  createdAt   DateTime    @default(now())
  /// "Info" popover: what this show/universe is about.
  lore        String      @default("")
  /// AI tools used (comma separated).
  aiTools     String      @default("")
  /// Genre tags (comma separated).
  tags        String      @default("")
  ageRating   String      @default("12+")
  /// Prompts / production notes from the creator (shared pool metadata).
  prompts     String      @default("")
  /// WebVTT or SRT subtitles shown while the broadcast is muted.
  captions    String      @default("")
  /// The catalog series this clip belongs to ("watch the whole series" funnel).
  seriesId    String?
  /// Bounty zone of the channel when the clip was uploaded: GREEN | YELLOW | RED | BOOST ("" = admin upload).
  bountyZone  String      @default("")
  /// Set once the bounty reward was paid (on approval).
  bountyPaidAt DateTime?

  channel TvChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator User?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  series  Series?      @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  slots   TvSlot[]
  likes   TvClipLike[]
  order   TvOrder?

  @@index([channelId, status, kind])
}

/// One entry of a channel's daily schedule (built lazily per UTC day).
model TvSlot {
  id          String    @id @default(cuid())
  channelId   String
  /// UTC day YYYY-MM-DD the slot belongs to.
  day         String
  startsAt    DateTime
  durationSec Int
  /// CLIP | EPISODE | HOST | BREAK | CHART
  kind        String
  clipId      String?
  episodeId   String?
  /// Host lines (HOST, CHART intro) written by the LLM showrunner or templates.
  textRu      String    @default("")
  textEn      String    @default("")
  /// BREAK: the sponsored clip bound to this break when it went on air.
  breakClipId String?
  /// QUIZ: {"q":{ru,en},"options":[{ru,en}…],"correct":n} — the answer never leaves the server before the slot ends.
  data        String    @default("")
  quizAnswers TvQuizAnswer[]
  channel     TvChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  clip        TvClip?   @relation(fields: [clipId], references: [id], onDelete: SetNull)
  episode     Episode?  @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@unique([channelId, startsAt])
  @@index([channelId, day])
}

/// Live chat message of a channel.
model TvMessage {
  id        String    @id @default(cuid())
  channelId String
  userId    String
  text      String
  /// Super chat: coins paid to highlight the message (0 = normal message).
  paid      Int       @default(0)
  reports   Int       @default(0)
  hidden    Boolean   @default(false)
  createdAt DateTime  @default(now())
  channel   TvChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

/// Paid SMS greeting in the crawling ticker (shown for a while to everyone on the channel).
model TvTicker {
  id        String    @id @default(cuid())
  channelId String
  userId    String
  text      String
  coins     Int
  hidden    Boolean   @default(false)
  createdAt DateTime  @default(now())
  channel   TvChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

/// "Put something crazy on air": a viewer pays, AI generates a clip, a moderator approves, it airs in a break.
model TvOrder {
  id           String    @id @default(cuid())
  userId       String
  channelId    String
  idea         String
  prompt       String    @default("")
  coins        Int
  /// GENERATING | REVIEW | APPROVED | AIRED | REJECTED | FAILED
  status       String    @default("GENERATING")
  jobId        String?
  clipId       String?   @unique
  rejectReason String?
  createdAt    DateTime  @default(now())
  airedAt      DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      TvChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  clip         TvClip?   @relation(fields: [clipId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

/// A viewer's like of a music video (drives the weekly Top 10).
model TvClipLike {
  userId    String
  clipId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip      TvClip   @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@id([userId, clipId])
  @@index([clipId, createdAt])
}

/// "What's next?" poll on air: viewers pick one of three programmes, the winner airs right after the current one.
model TvPoll {
  id         String       @id @default(cuid())
  channelId  String
  /// JSON array of clip/episode refs: [{"type":"CLIP","id":"…"}]
  options    String
  endsAt     DateTime
  /// Index of the winning option once resolved.
  winner     Int?
  resolved   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  channel    TvChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  votes      TvPollVote[]

  @@index([channelId, resolved, endsAt])
}

model TvPollVote {
  pollId    String
  userId    String
  option    Int
  createdAt DateTime @default(now())
  poll      TvPoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
}

model TvQuizAnswer {
  slotId    String
  userId    String
  choice    Int
  rewarded  Boolean  @default(false)
  createdAt DateTime @default(now())
  slot      TvSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([slotId, userId])
}

/// Seconds of TV a viewer watched on a UTC day (heartbeats), and how many 10-minute rewards were paid.
model TvWatch {
  userId   String
  day      String
  seconds  Int      @default(0)
  rewarded Int      @default(0)
  lastBeat DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

/// One round of the ad-break mini game (server-timed, so a score can't be posted without playing).
model TvGame {
  id         String    @id @default(cuid())
  userId     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int?
  gold       Int       @default(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

/// Admin's AI clip factory: an idea for a channel → a generation job → added to the channel as a clip.
model TvFactoryItem {
  id        String    @id @default(cuid())
  channelId String
  kind      String    @default("SHOW")
  title     String
  prompt    String
  jobId     String?
  /// DRAFT (idea) | GENERATING | READY | ADDED | FAILED
  status    String    @default("DRAFT")
  clipId    String?
  createdAt DateTime  @default(now())
  channel   TvChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

/// A viewer clicked "watch the whole series" during a broadcast (creator analytics).
model TvFunnelClick {
  id        String     @id @default(cuid())
  seriesId  String
  channelId String?
  userId    String?
  createdAt DateTime   @default(now())
  series    Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  channel   TvChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([seriesId, createdAt])
}

/// System alert / crawl shown over the broadcast to every viewer (all channels when channelId is null).
model TvAlert {
  id        String     @id @default(cuid())
  channelId String?
  text      String
  until     DateTime
  createdAt DateTime   @default(now())
  channel   TvChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([until])
}

/// Live teleprompter: the mascot reads an admin's text — picture-in-picture over the current video, or a breaking-news slot.
model TvInjection {
  id          String     @id @default(cuid())
  /// null = every channel.
  channelId   String?
  text        String
  /// PIP | BREAKING
  mode        String     @default("PIP")
  /// AUTO | ANGRY_RAGE | HYPE_EXCITED | LAUGH_SARCASM | SHOCK_SCARED
  tone        String     @default("AUTO")
  /// JSON emotional timeline (parseScriptToEmotionalTimeline).
  timeline    String
  /// Server TTS file (null = the viewer's browser speaks).
  audioUrl    String?
  startsAt    DateTime
  durationSec Int
  createdAt   DateTime   @default(now())
  channel     TvChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([startsAt])
}

/// Mascot clip bank: short loops per emotion stitched live by the DynamicMascotPlayer.
model MascotClip {
  id         String   @id @default(cuid())
  /// IDLE | NEUTRAL_TALK | HYPE_EXCITED | ANGRY_RAGE | LAUGH_SARCASM | SHOCK_SCARED | GLITCH_TRANSITION
  emotion    String
  url        String
  durationMs Int      @default(800)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([emotion, active])
}

/// Creator invite: every active creator has 5; a viewer who enters one becomes a creator.
model CreatorInvite {
  code      String    @id
  ownerId   String
  usedById  String?   @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  owner     User      @relation("InviteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  usedBy    User?     @relation("InviteUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

/// Creator's production planner: episodes to make, script notes, readiness checklist.
model CreatorTask {
  id        String    @id @default(cuid())
  creatorId String
  seriesId  String?
  title     String
  notes     String    @default("")
  dueAt     DateTime?
  /// TODO | DOING | DONE
  status    String    @default("TODO")
  /// JSON [{"t":"Script","done":false}]
  checklist String    @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  series    Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([creatorId, status])
}

/// One-click AI app showcase: packaged installers for people who don't use GitHub or a console.
model AiApp {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  taglineRu     String   @default("")
  taglineEn     String   @default("")
  descriptionRu String   @default("")
  descriptionEn String   @default("")
  /// IMAGE | VIDEO | VOICE | MUSIC | TEXT | TOOLS
  category      String   @default("TOOLS")
  hue           Int      @default(260)
  /// 0 = free.
  priceCoins    Int      @default(0)
  /// Stored installer refs (storage path or URL); empty = not available for that OS yet.
  winFile       String   @default("")
  macFile       String   @default("")
  /// Opens in the browser instead of a download.
  webUrl        String   @default("")
  /// Short requirement line, e.g. "Windows 10+, 8 GB GPU".
  requirements  String   @default("")
  featured      Boolean  @default(false)
  active        Boolean  @default(true)
  downloads     Int      @default(0)
  createdAt     DateTime @default(now())
  purchases     AiAppPurchase[]
}

model AiAppPurchase {
  userId    String
  appId     String
  coins     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app       AiApp    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([userId, appId])
}

/// A watch-buddy character or outfit piece the viewer owns (free ones are never stored).
model BuddyItem {
  userId    String
  itemId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
}

/// Background job queue (one worker per server process, see src/lib/jobs.ts). Survives restarts: RUNNING jobs
/// whose worker died are picked up again after JOB_STALE_MS.
model Job {
  id         String    @id @default(cuid())
  /// e.g. "music.render"
  kind       String
  /// JSON
  payload    String    @default("{}")
  /// QUEUED | RUNNING | DONE | FAILED
  status     String    @default("QUEUED")
  attempts   Int       @default(0)
  runAt      DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  @@index([status, runAt])
}

/// A song turned into a music video for the MUSIC channel: audio + cover/images + lyrics → rendered mp4 → TvClip.
model MusicTrack {
  id          String      @id @default(cuid())
  channelId   String
  userId      String
  title       String
  artist      String      @default("")
  /// storage:audio/…
  audioRef    String
  coverRef    String?
  /// JSON array of storage:images/… refs for the slideshow style.
  imagesJson  String      @default("[]")
  lyrics      String      @default("")
  /// JSON [{ "t": seconds, "text": "line" }] — line timings from the tap-sync tool or a pasted LRC.
  lrcJson     String      @default("")
  /// KARAOKE | BARS | WAVE | CIRCLE | CQT | VHS | SLIDESHOW | AI
  style       String      @default("KARAOKE")
  orientation Orientation @default(HORIZONTAL)
  durationSec Int         @default(0)
  bpm         Float       @default(0)
  /// ADMIN | CREATOR | ORDER (a viewer paid to air their song)
  source      String      @default("ADMIN")
  /// Viewer orders: coins paid, returned on rejection.
  coins       Int         @default(0)
  /// The uploader confirmed they own or may use the song.
  rightsOk    Boolean     @default(false)
  /// DRAFT | REVIEW (viewer order waits for a moderator) | QUEUED | RENDERING | READY | FAILED | REJECTED
  status      String      @default("DRAFT")
  progress    Int         @default(0)
  error       String?
  videoRef    String?
  clipId      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  channel TvChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

/// Watch party: friends watch a TV channel (already in sync for everyone) or a catalog episode in sync,
/// with a private chat, flying reactions, the shared remote, polls, a ready check and a group food order.
model Party {
  id           String    @id @default(cuid())
  /// Invite code in the link /party/CODE (6 chars, no look-alikes).
  code         String    @unique
  hostId       String
  /// Who holds the remote (switches channel/episode, play/pause/seek). Defaults to the host.
  remoteId     String
  title        String    @default("")
  /// TV | EPISODE
  mode         String    @default("TV")
  channelSlug  String?
  episodeId    String?
  /// EPISODE mode playback: position at stateAt; playing = advancing since then.
  playing      Boolean   @default(false)
  positionSec  Float     @default(0)
  stateAt      DateTime  @default(now())
  /// CINEMA | NEON | COZY | SPACE
  theme        String    @default("CINEMA")
  /// Ready check started (members answer); countdown → playback starts at countdownTo.
  readyCheckAt DateTime?
  countdownTo  DateTime?
  /// Food: who orders, where, when it arrives.
  foodById     String?
  foodService  String?
  foodEtaAt    DateTime?
  /// When the ETA was set (start of the playful "cooking → on the way → at the door" progress).
  foodEtaSetAt DateTime?
  foodArrivedAt DateTime?
  /// Active poll: JSON { id, question, options: string[] }; votes in PartyVote.
  pollJson     String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  endedAt      DateTime?

  host    User          @relation("PartyHost", fields: [hostId], references: [id], onDelete: Cascade)
  members PartyMember[]
  events  PartyEvent[]
  food    PartyFood[]
  votes   PartyVote[]
}

model PartyMember {
  partyId    String
  userId     String
  joinedAt   DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  readyAt    DateTime?
  kicked     Boolean   @default(false)

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([partyId, userId])
  @@index([userId])
}

/// One stream for everything that happens in the room: CHAT | REACTION | MOMENT | SYSTEM.
model PartyEvent {
  id        String   @id @default(cuid())
  partyId   String
  userId    String?
  kind      String
  body      String
  /// MOMENT: position in the episode / wall-clock for TV.
  atSec     Float?
  createdAt DateTime @default(now())

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([partyId, createdAt])
}

/// Group food order: what each member wants (price optional, for the split).
model PartyFood {
  id         String   @id @default(cuid())
  partyId    String
  userId     String
  item       String
  priceCents Int?
  qty        Int      @default(1)
  createdAt  DateTime @default(now())

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partyId])
}

model PartyVote {
  partyId String
  pollId  String
  userId  String
  option  Int

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([partyId])
}

/// "Moment": a viewer cuts the last ~20 s of the live broadcast into a shareable clip (/m/<id>).
model TvMoment {
  id          String   @id @default(cuid())
  userId      String
  channelSlug String
  title       String
  sourceRef   String
  startSec    Float
  durationSec Float
  /// QUEUED | READY | FAILED
  status      String   @default("QUEUED")
  videoRef    String?
  thumbRef    String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Per-channel audience by hour (UTC): watched minutes of signed-in viewers (one per minute heartbeat)
/// and the peak of concurrent viewers incl. guests. Feeds /admin/tv/analytics.
model TvChannelStat {
  channelId String
  day       String
  hour      Int
  minutes   Int    @default(0)
  peak      Int    @default(0)

  @@id([channelId, day, hour])
  @@index([day])
}

/// Clicks that leave MIRAGE for a partner (e.g. "Open Bolt Food" in a watch party). Numbers to show partners.
model OutboundClick {
  id        String   @id @default(cuid())
  /// FOOD
  kind      String
  /// e.g. BOLT, WOLT
  target    String
  userId    String?
  partyId   String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// A song in the music feed: the author picks a 15 s hook; the feed plays hooks, a ♥ saves the whole song.
model Song {
  id           String     @id @default(cuid())
  userId       String
  title        String
  artist       String     @default("")
  genre        String     @default("")
  audioRef     String
  coverRef     String?
  lyrics       String     @default("")
  durationSec  Int        @default(0)
  bpm          Float      @default(0)
  hookStart    Float      @default(0)
  hookLen      Float      @default(15)
  /// HUMAN | SUNO_PAID | UDIO_PAID | OTHER_AI — shown as an "AI music" label; free-plan Suno songs are refused.
  aiTool       String     @default("HUMAN")
  /// PUBLISHED | HIDDEN (taken down by a moderator)
  status       String     @default("PUBLISHED")
  hookPlays    Int        @default(0)
  plays        Int        @default(0)
  saves        Int        @default(0)
  /// Sent to a music channel (the MusicTrack that renders its video).
  airedTrackId String?
  createdAt    DateTime   @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedBy  SongSave[]
  seenBy   SongSeen[]

  @@index([status, createdAt])
}

model SongSave {
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
  @@index([songId, createdAt])
}

/// Hooks a viewer already heard, so the feed keeps bringing new ones.
model SongSeen {
  userId    String
  songId    String
  createdAt DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
}
