DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-to-a-long-random-string"
ALLOW_MOCK_PAYMENTS="1"

# Character chat (18+ fan service). "mock" = offline scripted replies.
# "openai" = any OpenAI-compatible /chat/completions API (OpenRouter, DeepSeek, Together, Ollama...).
CHAT_PROVIDER="mock"
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_API_KEY=""
# LLM_MODEL="deepseek/deepseek-chat"
# OpenRouter free: LLM_MODEL="nvidia/nemotron-3.5-super-vl:free", LLM_FALLBACK_MODELS="nvidia/nemotron-3-ultra-550b-a55b:free"
# Ollama Cloud (free model): LLM_BASE_URL="https://ollama.com/v1", LLM_MODEL="beam", LLM_REASONING_EFFORT="low"
# DeepSeek directly: LLM_BASE_URL="https://api.deepseek.com", LLM_MODEL="deepseek-chat"
# LLM_FALLBACK="1"   # demo only: reply with scripted lines when the provider fails (otherwise: error, no charge)

# Email (password reset). "console" prints emails to the server log.
MAIL_PROVIDER="console"
# MAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# MAIL_FROM="MIRAGE <no-reply@your.domain>"
# Public site URL for links in emails. REQUIRED in production (without it reset emails are not sent);
# in development links always point to localhost.
# APP_URL="https://mirage.example"

# AI video generation: "mock" (demo clips) or "ltx" (free LTX-Video on a Hugging Face Space, ~10–60 s per clip, ≤ 8 s)
GEN_PROVIDER="mock"
# HF_TOKEN=""          # optional free Hugging Face token: bigger daily GPU quota
# LTX_SPACE_URL="https://lightricks-ltx-video-distilled.hf.space"

# Mascot voice (live teleprompter). Empty = every viewer's browser speaks the text (free).
# TTS_PROVIDER="openai"                       # any OpenAI-compatible /audio/speech endpoint
# TTS_BASE_URL="https://api.openai.com/v1"
# TTS_API_KEY=""
# TTS_MODEL="tts-1"
# TTS_VOICE_RU="onyx"
# TTS_VOICE_EN="onyx"
